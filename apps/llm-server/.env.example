# DesAny LLM Server (vLLM + Qwen3-30B-A3B) configuration.
# Copy to .env when running standalone; in compose these are set in docker-compose.yml.

# --- vLLM runtime ---

# Hugging Face model id loaded into vLLM. The Qwen3 MoE has ~3B active params
# per token over 30B total. Override to point at a fine-tuned variant if needed.
MODEL_NAME=Qwen/Qwen3-30B-A3B

# Alias clients use in the OpenAI "model" field. Other services hardcode this
# (see LLM_MODEL_NAME in the root .env.example), so change with care.
SERVED_MODEL_NAME=qwen3-moe

# Number of GPUs to shard the model across.
#   1 = single 80 GB GPU (A100/H100).
#   2 = two ~48 GB GPUs (A6000/L40S).
TENSOR_PARALLEL_SIZE=1

# Max context length (prompt + completion) in tokens. KV cache VRAM scales
# linearly with this; lower it (e.g. 4096) if you OOM on smaller GPUs.
MAX_MODEL_LEN=8192

# Fraction of GPU VRAM vLLM may use, in (0, 1]. Lower (e.g. 0.85) if other
# processes share the GPU or you see OOM during KV cache allocation.
GPU_MEM_UTIL=0.90

# Bind address and port inside the container. Compose maps PORT to host 8000.
HOST=0.0.0.0
PORT=8000

# --- Client / warm-up script (warm-up.ts) ---

# Base URL the warm-up script targets. Inside docker-compose use
# http://llm-server:8000/v1; from the host use http://localhost:8000/v1.
LLM_BASE_URL=http://localhost:8000/v1

# Model alias used by the warm-up script; must match SERVED_MODEL_NAME above.
LLM_MODEL_NAME=qwen3-moe

# vLLM does not require an API key, but the openai SDK insists on a non-empty
# string. Any placeholder works.
LLM_API_KEY=sk-not-needed

# --- Optional: Hugging Face authentication ---

# Only needed if you point MODEL_NAME at a gated/private repo, or you've
# enabled HF login. The base Qwen3-30B-A3B is public.
# HUGGING_FACE_HUB_TOKEN=hf_xxx
