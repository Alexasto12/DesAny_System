# HTTP server
PORT=3000
HOST=0.0.0.0

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Postgres
DATABASE_URL=postgresql://desany:desany@localhost:5432/desany

# Observability
LOG_LEVEL=info

# Scheduler (safety net)
# Interval in milliseconds between safety-net sweeps. Default: 5 minutes.
SCHEDULER_INTERVAL_MS=300000
# How long a 'running' pipeline_jobs row can sit untouched before being
# considered stuck and re-enqueued. Default: 30 minutes.
STUCK_JOB_TIMEOUT_MS=1800000

# CLI default — where `desany` looks for the HTTP API when no --api flag is set.
DESANY_API_URL=http://localhost:3000
